{
  "expo": {
    "name": "Critic",
    "slug": "critic-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alexpetrusca.critic-mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#08080a"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "apiBaseUrl": ""
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
